{
  "about": "Decisions 146b and 151 N5: the permission mode a person chooses at launch, or a start_agent names, per agent. Storm passes the agent's own mode through and sets none of its own. The server (apps/server/src/agent/permission.rs) refuses a mode an agent does not offer with permission_mode_unavailable, and a start's mode other than `default` or its parent's own with permission_mode_wider; a start without one gets its parent's mode when its agent offers it, else `default` (`inherit`). The host (apps/runtime/src/profile.rs, permission_mode) refuses it again and turns an accepted one into exactly `args` (the agent's own launch flag) and `opencode_permission` (keys Storm's OpenCode config layer sets). `default` passes nothing for every agent, so the agent's own config decides; a child takes the same mapping as any session, on every host. Neither crate depends on the other: this file keeps them on one rule.",
  "modes": ["default", "accept_edits", "plan", "auto", "dont_ask", "bypass"],
  "offered": {
    "claude-code": ["default", "accept_edits", "plan", "auto", "dont_ask", "bypass"],
    "opencode": ["default", "accept_edits"],
    "codex": ["default"],
    "cursor": ["default"],
    "command-code": ["default"],
    "shell": ["default"]
  },
  "accepted": [
    {"agent": "claude-code", "mode": "default", "args": [], "opencode_permission": {}},
    {"agent": "claude-code", "mode": "accept_edits", "args": ["--permission-mode", "acceptEdits"], "opencode_permission": {}},
    {"agent": "claude-code", "mode": "plan", "args": ["--permission-mode", "plan"], "opencode_permission": {}},
    {"agent": "claude-code", "mode": "auto", "args": ["--permission-mode", "auto"], "opencode_permission": {}},
    {"agent": "claude-code", "mode": "dont_ask", "args": ["--permission-mode", "dontAsk"], "opencode_permission": {}},
    {"agent": "claude-code", "mode": "bypass", "args": ["--permission-mode", "bypassPermissions"], "opencode_permission": {}},
    {"agent": "opencode", "mode": "default", "args": [], "opencode_permission": {}},
    {"agent": "opencode", "mode": "accept_edits", "args": [], "opencode_permission": {"edit": "allow"}},
    {"agent": "codex", "mode": "default", "args": [], "opencode_permission": {}},
    {"agent": "cursor", "mode": "default", "args": [], "opencode_permission": {}},
    {"agent": "command-code", "mode": "default", "args": [], "opencode_permission": {}},
    {"agent": "shell", "mode": "default", "args": [], "opencode_permission": {}}
  ],
  "refused": [
    {"agent": "opencode", "mode": "auto"},
    {"agent": "opencode", "mode": "bypass"},
    {"agent": "codex", "mode": "accept_edits"},
    {"agent": "codex", "mode": "auto"},
    {"agent": "codex", "mode": "bypass"},
    {"agent": "cursor", "mode": "accept_edits"},
    {"agent": "command-code", "mode": "auto"},
    {"agent": "shell", "mode": "accept_edits"},
    {"agent": "claude-code", "mode": "bypassPermissions"},
    {"agent": "claude-code", "mode": "acceptEdits"},
    {"agent": "claude-code", "mode": "dontAsk"},
    {"agent": "claude-code", "mode": "--dangerously-skip-permissions"},
    {"agent": "claude-code", "mode": "Auto"},
    {"agent": "claude-code", "mode": ""}
  ],
  "inherit": [
    {"parent": "default", "agent": "claude-code", "child": "default"},
    {"parent": "accept_edits", "agent": "claude-code", "child": "accept_edits"},
    {"parent": "auto", "agent": "claude-code", "child": "auto"},
    {"parent": "bypass", "agent": "claude-code", "child": "bypass"},
    {"parent": "dont_ask", "agent": "claude-code", "child": "dont_ask"},
    {"parent": "default", "agent": "opencode", "child": "default"},
    {"parent": "accept_edits", "agent": "opencode", "child": "accept_edits"},
    {"parent": "auto", "agent": "opencode", "child": "default"},
    {"parent": "auto", "agent": "codex", "child": "default"},
    {"parent": "accept_edits", "agent": "cursor", "child": "default"},
    {"parent": "bypass", "agent": "command-code", "child": "default"}
  ]
