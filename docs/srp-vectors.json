  "hello_pubkey": {
    "about": "Revision 115, decision 114f: a client names the key it pinned, in HELLO.pubkey and in the connect URL's pubkey query. Same encoding as REGISTER_SERVER.pubkey: base64url, unpadded, 32 bytes, compared as decoded bytes. An open (key-addressed) relay routes the HELLO to the registration (server_id, pubkey).",
    "connect_url": {
      "relay_base": "wss://relay.example",
      "server_id": "srv_01ARZ3NDEKTSV4RRFFQ69G5FAV",
      "pubkey_b64": "A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg",
      "url": "wss://relay.example/connect/srv_01ARZ3NDEKTSV4RRFFQ69G5FAV?pubkey=A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg",
      "why": "base64url's alphabet is URL-safe, so the key needs no percent-encoding."
    },
    "cases": [
      {
        "name": "unpadded",
        "pubkey": "A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg",
        "accepted": true
      },
      {
        "name": "padded",
        "pubkey": "A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=",
        "accepted": false
      },
      {
        "name": "standard_alphabet",
        "pubkey": "A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg",
        "accepted": false
      },
      {
        "name": "too_short",
        "pubkey": "A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMQ",
        "accepted": false
      },
      {
        "name": "empty",
        "pubkey": "",
        "accepted": false
      }
    ],
    "query_and_hello_must_agree": {
      "query_pubkey": "A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg",
      "hello_pubkey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "result": "protocol_error"
    }
  },
