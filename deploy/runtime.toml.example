# /etc/storm-runtime/runtime.toml: the Storm Runtime Host's configuration
# (freeze §5.7). Every value here is an operational default, not a limit.

# Each subdirectory of a root is a workspace, named by its directory name. A
# root outside /var/lib/storm-runtime also needs a ReadWritePaths drop-in on
# the unit. A root inside, or around, a Storm data root is refused (D3).
workspace_roots = ["/var/lib/storm-runtime/workspaces"]

max_sessions = 8
scrollback_bytes = 4194304

# Where agent CLIs are looked for, and the PATH every session gets (PLAN.md
# 83, AM38). Omitted, the unit's own PATH is kept. A CLI must be on a path
# the storm-runtime account can reach (ProtectHome hides /home).
# path = ["/usr/local/bin", "/usr/bin", "/bin"]

# Omit [[providers]] entirely to offer the three built-ins: claude-code
# (the default), opencode and shell. To choose, list them:
#
# [[providers]]
# id = "claude-code"
#
# [[providers]]
# id = "shell"
# command = "/bin/bash"
# args = ["-l"]
#
# Provider secrets go in an env file, mode 0600, never here:
#
# [[providers]]
# id = "opencode"
# env_file = "/etc/storm-runtime/opencode.env"
#
# A session with integrations runs OpenCode with a config directory of its
# own (MCP Gateway, decision 81f), so ~/.config/opencode is not loaded. Put
# the OpenCode settings sessions need here; they are merged into each
# session's config. An `mcp` key here is ignored: only Storm's integrations
# are ever offered to an agent.
#
# [[providers]]
# id = "opencode"
# [providers.settings]
# model = "anthropic/claude-sonnet-4-5"
