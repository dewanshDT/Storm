# /etc/storm-runtime/runtime.toml: the Storm Runtime Host's configuration
# (freeze §5.7). Every value here is an operational default, not a limit.

# Each subdirectory of a root is a workspace, named by its directory name. A
# root outside /var/lib/storm-runtime also needs a ReadWritePaths drop-in on
# the unit. A root inside, or around, a Storm data root is refused (D3).
workspace_roots = ["/var/lib/storm-runtime/workspaces"]

max_sessions = 8
scrollback_bytes = 4194304

# Where agent CLIs are looked for, and the PATH every session gets (decision
# 83, AM38). Omitted, the unit's own PATH is kept. A CLI must be on a path
# the storm-runtime account can reach (ProtectHome hides /home).
# path = ["/usr/local/bin", "/usr/bin", "/bin"]

# A session gets your integrations beside the MCP servers its agent loads by
# itself: the ones you added on this host, its plugins', a project's (under
# the agent's own prompts). "storm-only" gives sessions Storm's servers alone
# (decision 132).
# agent_mcp = "own"

# Agent CLIs from the app (decision 133): Settings › Agents may install,
# update and remove Claude Code, OpenCode, Codex, Cursor and Command Code on
# this host, into <state>/agents/managed, which comes first on the path; a CLI
# installed elsewhere still works and is never touched. "off" if you pin CLIs
# by hand. Storm updates its own copies once a day, while none of that agent's
# sessions runs, unless agent_updates is "manual".
# agent_install = "on"
# agent_updates = "auto"

# With agent_mcp = "storm-only": whether a Claude Code or Codex session still
# gets its enabled plugins' local (stdio) MCP servers (decision 131b).
# plugin_mcp = "allow"

# Omit [[providers]] entirely to offer every built-in (decision 130):
# claude-code (the default), opencode, codex, cursor, command-code and shell.
# One that is not installed is offered as not installed. claude-code,
# opencode and codex get your integrations and Resume (codex keeps its login
# and conversations in <state>/agents/codex; log it in with CODEX_HOME set
# there); cursor (`cursor-agent`) and
# command-code are terminals only: Storm cannot keep a repository's own MCP
# servers out of them, so they get no integrations. To choose, list them:
#
# [[providers]]
# id = "claude-code"
#
# [[providers]]
# id = "shell"
# command = "/bin/bash"
# args = ["-l"]
#
# Provider secrets go in an env file, mode 0600, never here:
#
# [[providers]]
# id = "opencode"
# env_file = "/etc/storm-runtime/opencode.env"
#
# A session with integrations runs OpenCode with a config directory of its
# own (MCP Gateway, decision 81f), so ~/.config/opencode is not loaded. Put
# the OpenCode settings sessions need here; they are merged into each
# session's config. An `mcp` key here is ignored: only Storm's integrations
# are ever offered to an agent.
#
# [[providers]]
# id = "opencode"
# [providers.settings]
# model = "anthropic/claude-sonnet-4-5"
