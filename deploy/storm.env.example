# Storm server configuration. Install to /etc/storm/storm.env, chmod 600.
#
# Prefer `sudo storm-server up` — it writes this file. The token is the only
# thing standing between the network and the vault, so this file must not be
# world-readable — it is why the token is here rather than on the command line,
# where /proc would expose it to every local user.

# Generated by `storm-server up` (or: openssl rand -hex 32)
STORM_TOKEN=change-me

# The storage root: a directory holding one directory per vault, NOT a vault
# itself. Pointing this at a vault would make Storm treat that vault's own
# folders as vaults. Default data root is /srv/storm; `up --data-root` changes
# these three paths together.
STORM_VAULT_ROOT=/srv/storm/vaults
STORM_STATE=/srv/storm/state

# Package-owned web client — upgraded with the .deb, not under the data root.
STORM_WEB=/usr/share/storm/web

# 0.0.0.0 exposes the server to the whole LAN, which is the point — the phone
# has to reach it. v1 has no TLS and one shared token, so this must not be
# port-forwarded or reverse-proxied to the internet as it stands.
STORM_HOST=0.0.0.0
STORM_PORT=8484

# Where nightly backups go. A path on the TrueNAS mount is the point of the
# exercise; a local path only protects against mistakes, not disk loss.
STORM_BACKUP_DEST=/srv/storm/backups
STORM_BACKUP_KEEP_DAYS=30
