# storm-relay configuration, read by /lib/systemd/system/storm-relay.service.
# Nothing in here is secret; the relay holds no credentials (R12).

# Where the relay listens. 8486, not 8484: storm-server owns 8484, and both on
# one box is how phase 4 is built and tested before it moves to a VPS.
# Loopback by default. On a public VPS, with TLS below: 0.0.0.0:443.
STORM_RELAY_BIND=127.0.0.1:8486

# REQUIRED. What clients dial: scheme, host and port, no trailing slash.
# Servers are handed <this>/connect/<server_id> as their public_address.
#STORM_RELAY_PUBLIC_BASE=wss://relay.example.com

# How server keys are bound (docs/srp-v1.md §4.1). Set exactly one; setting
# both stops the relay.
#
# Trust-on-first-use, persisted: the first key to register a server_id owns it
# for good, and survives restarts (decision 69). Safe only where you control
# who can reach the relay at all.
STORM_RELAY_BINDINGS=/var/lib/storm-relay/bindings
#
# Allowlist: only the listed keys may register. The safer choice for a relay
# on a public address. Comment out STORM_RELAY_BINDINGS when you use it.
# Format: `<server_id> <pubkey>` per line (`storm-server status` shows both).
#STORM_RELAY_ALLOWLIST=/etc/storm-relay/allowlist

# TLS, terminated by the relay itself (decision 71). Required on a public
# address. Not a proxy in front: behind one, every client would arrive from the
# proxy's address, sharing one HELLO rate limit and one relay_peer_ip at the
# origin. Point these at copies readable by the storm-relay user (see
# deploy/README.md); `systemctl reload storm-relay` picks up a renewal.
#STORM_RELAY_TLS_CERT=/etc/storm-relay/tls/fullchain.pem
#STORM_RELAY_TLS_KEY=/etc/storm-relay/tls/privkey.pem

# Log level.
RUST_LOG=storm_relay=info
