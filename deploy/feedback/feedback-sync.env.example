# feedback-sync configuration (decision 162-6). Install to
# /etc/storm-feedback-sync.env, chmod 600 — it holds SYNC_TOKEN.
#
# This is not part of the Storm product: a standalone script plus a systemd
# timer that pulls reports out of apps/feedback-cf and files them into the
# vault. The device credential it pairs for itself lives in STATE_DIR, not
# here.

# The Storm server this box's account runs — same URL you'd put in the
# client. No trailing slash needed either way.
STORM_URL=http://127.0.0.1:8484

# The vault id to write into (GET /v1/vaults lists them; `storm-server`'s own
# tooling or the app's URL bar shows the id). Reports land under
# FEEDBACK_FOLDER/Inbox in this vault, and Storm/Feedback/Feedback.md in it
# must already exist with an "## Inbox (new)" section.
STORM_VAULT=

# Where reports land, relative to the vault root. Default: Storm/Feedback.
#FEEDBACK_FOLDER=Storm/Feedback

# The apps/feedback-cf Worker's base URL (its wrangler deployment's
# workers.dev or custom domain).
INTAKE_URL=https://feedback.example.workers.dev

# The bearer secret the Worker's GET/DELETE /v1/reports* checks
# (apps/feedback-cf's SYNC_TOKEN binding — set the same value on both sides).
SYNC_TOKEN=

# Where the paired device credential and the synced-report map live.
# StateDirectory=storm-feedback-sync in the unit already points this at
# /var/lib/storm-feedback-sync; only change it together with the unit.
#STATE_DIR=/var/lib/storm-feedback-sync
