#!/bin/sh
set -e

# Only on removal. dpkg also runs prerm with `upgrade`, and stopping or
# disabling there would leave an upgraded host that no longer runs (#46).
case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl stop storm-runtime 2>/dev/null || true
            systemctl disable storm-runtime 2>/dev/null || true
            # Its binary is going. Workspaces stay as they are; reinstall and
            # run `storm-runtime-isolation off` to restore them (decision 136).
            systemctl disable --now storm-runtime-isolation.socket storm-runtime-isolation.service 2>/dev/null || true
        fi
        ;;
esac

exit 0
