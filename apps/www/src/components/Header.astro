---
import BrandMark from "./BrandMark.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const onHome = path === "/";

const links = [
  { href: onHome ? "#docs" : "/#docs", label: "Docs" },
  {
    href: "https://github.com/dewanshDT/Storm",
    label: "GitHub",
    external: true,
  },
];
---

<header class="site-header">
  <div class="wrap bar">
    <div class="brand">
      <a class="home" href="/" aria-label="Storm home">
        <BrandMark size="sm" />
      </a>
      <span class="pre-release" title="Storm is currently a pre-release">
        Pre-release
      </span>
    </div>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary" data-site-nav>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            {...(link.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {link.label}
          </a>
        ))
      }
      <a
        class:list={["btn", "btn-primary", "nav-install", path === "/install" && "is-active"]}
        href="/install"
      >
        Install
      </a>
    </nav>
  </div>
</header>

<script>
  function wireMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const nav = document.querySelector<HTMLElement>("[data-site-nav]");
    if (!toggle || !nav || toggle.dataset.wired) return;
    toggle.dataset.wired = "1";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      nav.classList.toggle("is-open", open);
      document.body.classList.toggle("nav-open", open);
    };

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      setOpen(open);
    });

    nav.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setOpen(false));
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }

  wireMenu();
  document.addEventListener("astro:page-load", wireMenu);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(10px);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    border-bottom: var(--bw) solid color-mix(in oklab, var(--border) 80%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--sp) * 2);
    min-height: 64px;
    position: relative;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: calc(var(--sp) * 1.25);
    z-index: 1;
    min-width: 0;
    line-height: 1;
  }

  .home {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    line-height: 1;
  }

  .home:hover {
    color: inherit;
  }

  .pre-release {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    padding: 0 calc(var(--sp) * 1);
    border: var(--bw) solid color-mix(in oklab, var(--amber) 35%, var(--border));
    border-radius: var(--r-card);
    background: var(--amber-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
    white-space: nowrap;
    line-height: 1;
  }

  .menu-toggle {
    display: none;
    appearance: none;
    border: var(--bw) solid var(--border);
    background: var(--surface);
    color: var(--text);
    width: 40px;
    height: 40px;
    border-radius: var(--r-control);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .menu-icon {
    display: block;
    width: 16px;
    height: 1px;
    background: currentColor;
    box-shadow:
      0 -5px 0 currentColor,
      0 5px 0 currentColor;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: calc(var(--sp) * 0.5);
  }

  .nav-link {
    padding: calc(var(--sp) * 0.75) calc(var(--sp) * 1.25);
    border-radius: var(--r-control);
    color: var(--text2);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--surface);
    text-decoration: none;
  }

  .nav-install {
    margin-left: calc(var(--sp) * 1);
    min-height: 36px;
    padding-inline: calc(var(--sp) * 1.75);
  }

  @media (max-width: 640px) {
    .bar {
      min-height: 56px;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: calc(var(--sp) * 0.5);
      padding: calc(var(--sp) * 2);
      background: var(--bg);
      border-bottom: var(--bw) solid var(--border);
      box-shadow: var(--shadow);
    }

    .site-nav.is-open {
      display: flex;
    }

    .nav-link {
      padding: calc(var(--sp) * 1.25) calc(var(--sp) * 1.5);
    }

    .nav-install {
      margin-left: 0;
      margin-top: calc(var(--sp) * 0.5);
      width: 100%;
    }
  }
</style>
