---
import { release } from "../data/release";

interface Props {
  /** Section label shown above the heading */
  label?: string;
  /** Anchor id for deep links */
  id?: string;
  /** Show the page-style display heading */
  displayHeading?: boolean;
  /** Where “Open →” for Web should go */
  webOpenHref?: string;
  /** Footer link to server install docs */
  installHref?: string;
}

const {
  label = "Clients",
  id = "clients",
  displayHeading = true,
  webOpenHref = "/install#start",
  installHref = "/install",
} = Astro.props;

const { macos, android, web } = release;
const rows = [macos, android, web];
---

<section class="get-storm" id={id} aria-labelledby={`${id}-heading`} data-get-storm>
  {
    label && (
      <p class="section-label">{label}</p>
    )
  }
  {
    displayHeading ? (
      <h1 id={`${id}-heading`} class="display">
        One client.
        <br />
        Your devices.
      </h1>
    ) : (
      <h2 id={`${id}-heading`}>Get Storm</h2>
    )
  }
  <p class="support">
    Download Storm for your device, or open the web client directly from your
    server.
  </p>

  <ul class="manifest" role="list">
    {
      rows.map((row) => (
        <li class="row" id={row.id} data-platform={row.detect}>
          <div class="row-main">
            <div class="info">
              <div class="name-line">
                <span class="name">{row.platform}</span>
                <span class="rec" hidden data-rec>
                  Current
                </span>
              </div>
              <p class="meta mono">
                {row.meta}
                {row.action === "download" && (
                  <>
                    {" · "}
                    {release.tag}
                  </>
                )}
              </p>
              <p class="blurb">{row.blurb}</p>
              {row.note && <p class="note mono">{row.note}</p>}
            </div>
            <div class="actions">
              {row.action === "download" ? (
                <>
                  <a
                    class="action"
                    href={row.url}
                    download
                    aria-label={row.aria}
                  >
                    {row.cta}
                  </a>
                  <p class="file mono">{row.file}</p>
                </>
              ) : (
                <>
                  <a class="action" href={webOpenHref} aria-label={row.aria}>
                    {row.cta}
                  </a>
                  <a
                    class="secondary"
                    href={row.url}
                    download
                    aria-label={`Download Storm web bundle ${row.file}`}
                  >
                    Self-host the web client separately →
                  </a>
                </>
              )}
            </div>
          </div>
        </li>
      ))
    }

    <li class="row row--muted" id="linux">
      <div class="row-main">
        <div class="info">
          <div class="name-line">
            <span class="name">Linux</span>
          </div>
          <p class="meta mono">Desktop client deferred</p>
          <p class="blurb">
            The web client works on Linux today. A native desktop build is not
            shipping yet.
          </p>
        </div>
        <div class="actions">
          <a class="action action--ghost" href={`${id === "clients" ? "#web" : "/clients#web"}`}>
            Use Web →
          </a>
        </div>
      </div>
    </li>
  </ul>

  <div class="release-foot">
    <p class="mono">Current release · {release.tag}</p>
    <nav class="footer-links" aria-label="Release resources">
      <a href={release.checksumsUrl} target="_blank" rel="noopener noreferrer"
        >Checksums</a
      >
      <a href={release.notesUrl} target="_blank" rel="noopener noreferrer"
        >Release notes</a
      >
      <a href={release.allUrl} target="_blank" rel="noopener noreferrer"
        >All releases</a
      >
      <a href={installHref}>Installation →</a>
    </nav>
  </div>
</section>

<script>
  function detectPlatform(): "mac" | "android" | "web" | null {
    const ua = navigator.userAgent;
    if (/Android/i.test(ua)) return "android";
    if (/Mac OS X|Macintosh/i.test(ua) && !/iPhone|iPad|iPod/i.test(ua)) {
      return "mac";
    }
    if (/Win|Linux|CrOS/i.test(ua) && !/Android/i.test(ua)) return "web";
    return null;
  }

  function markRecommended() {
    const root = document.querySelector("[data-get-storm]");
    if (!root) return;
    const platform = detectPlatform();
    if (!platform) return;
    root.querySelectorAll<HTMLElement>("[data-platform]").forEach((row) => {
      const rec = row.querySelector<HTMLElement>("[data-rec]");
      if (!rec) return;
      const match = row.dataset.platform === platform;
      rec.hidden = !match;
      row.classList.toggle("is-current", match);
    });
  }

  markRecommended();
  document.addEventListener("astro:page-load", markRecommended);
</script>

<style>
  .get-storm {
    max-width: 42rem;
  }

  .display {
    margin: 0 0 calc(var(--sp) * 2.5);
    font-family: var(--font-body);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: var(--text);
  }

  .get-storm .support {
    margin-bottom: calc(var(--sp) * 4);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--text3);
  }

  .manifest {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--bw) solid var(--border);
  }

  .row {
    border-bottom: var(--bw) solid var(--border);
  }

  .row.is-current {
    background: color-mix(in oklab, var(--accent-soft) 40%, transparent);
  }

  .row--muted .name {
    color: var(--text2);
  }

  .row-main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: calc(var(--sp) * 2) calc(var(--sp) * 3);
    padding: calc(var(--sp) * 3) 0;
  }

  .info {
    min-width: min(100%, 16rem);
    flex: 1 1 14rem;
  }

  .name-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: calc(var(--sp) * 1) calc(var(--sp) * 1.5);
    margin-bottom: calc(var(--sp) * 0.75);
  }

  .name {
    font-family: var(--font-sans);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .rec {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .meta,
  .blurb,
  .note,
  .file {
    margin: 0;
    line-height: 1.45;
  }

  .blurb {
    margin-top: calc(var(--sp) * 1);
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--text2);
    max-width: 28rem;
  }

  .note {
    margin-top: calc(var(--sp) * 1);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(var(--sp) * 0.75);
    margin-left: auto;
    padding-top: 2px;
  }

  .action {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color var(--dur) var(--ease);
  }

  .action:hover {
    color: var(--text);
  }

  .action--ghost {
    color: var(--text2);
  }

  .file {
    max-width: 16rem;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .secondary {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text3);
    text-decoration: none;
    letter-spacing: 0.02em;
    text-align: right;
    max-width: 16rem;
  }

  .secondary:hover {
    color: var(--accent);
  }

  .release-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--sp) * 2);
    margin-top: calc(var(--sp) * 3);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--sp) * 1) calc(var(--sp) * 2.5);
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--text2);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .row-main {
      flex-direction: column;
      align-items: stretch;
    }

    .actions {
      align-items: flex-start;
      margin-left: 0;
    }

    .file,
    .secondary {
      text-align: left;
      max-width: none;
    }
  }
</style>
