---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <p class="word">Storm</p>
        <p class="tagline">
          Your knowledge.<br />On your infrastructure.
        </p>
      </div>
      <nav class="links" aria-label="Footer">
        <a href="/#docs">Documentation</a>
        <a href="/clients">Clients</a>
        <a href="/install">Installation</a>
        <a href="https://github.com/dewanshDT/Storm" target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <a
          href="https://github.com/dewanshDT/Storm/blob/main/apps/server/README.md"
          target="_blank"
          rel="noopener noreferrer">MCP</a
        >
      </nav>
    </div>

    <hr class="hr" />

    <div class="bottom">
      <p class="meta">Rust · Flutter · Markdown · MCP</p>
      <p class="legal">
        © {year} ·
        <a
          href="https://github.com/dewanshDT/Storm/blob/main/LICENSE"
          target="_blank"
          rel="noopener noreferrer">MIT</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: var(--bw) solid var(--border);
    padding: calc(var(--sp) * 6) 0 calc(var(--sp) * 5);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(var(--sp) * 4);
  }

  .word {
    margin: 0 0 calc(var(--sp) * 1.5);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
  }

  .tagline {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    line-height: 1.35;
    color: var(--text2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--sp) * 1) calc(var(--sp) * 2.5);
    align-content: flex-start;
  }

  .links a {
    font-size: var(--fs-sm);
    color: var(--text2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--text);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(var(--sp) * 2);
  }

  .meta,
  .legal {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text3);
    letter-spacing: 0.04em;
  }

  .legal a {
    color: inherit;
    text-decoration: none;
  }

  .legal a:hover {
    color: var(--text);
  }
</style>
