---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { release } from "../data/release";
import facts from "../data/facts.json";

// Generated from apps/server/src/mcp.rs by tools/www-facts; CI fails when the
// committed file is stale, so these lists cannot fall behind the server.
const mcpReadTools = facts.mcp_tools.filter((t) => t.access === "read").map((t) => t.name);
const mcpWriteTools = facts.mcp_tools.filter((t) => t.access === "write").map((t) => t.name);
const mcpAgentTools = facts.mcp_tools.filter((t) => t.access === "agents").map((t) => t.name);
const neverForAgents = facts.mcp_tools.filter((t) => !t.agents).map((t) => t.name);
const mcpTools = [...mcpReadTools, ...mcpWriteTools];

const platforms = [
  { what: "Server", linux: "yes", macos: "yes", windows: "yes", android: "—", web: "—" },
  { what: "Runtime Host (agents)", linux: "yes", macos: "yes", windows: "yes", android: "—", web: "—" },
  { what: "App", linux: "yes", macos: "yes", windows: "yes", android: "yes", web: "yes" },
];

const docs = [
  { href: "/docs/start/quickstart/", title: "Quickstart", body: "Server to phone in a few minutes." },
  { href: "/docs/install/server/", title: "Install", body: "Linux, macOS, Windows; pairing; firewalls." },
  { href: "/docs/notes/writing/", title: "Notes", body: "Writing, vaults, sync and conflicts." },
  { href: "/docs/agents/sessions/", title: "Agents", body: "Sessions, crews, Runtime Hosts, integrations." },
  { href: "/docs/mcp/connect/", title: "MCP", body: "Connect Claude Code, Claude Desktop, Cursor." },
  { href: "/docs/reference/mcp-tools/", title: "Reference", body: "Tools, CLIs and config, generated." },
];

const description =
  "Storm is a self-hosted, Markdown-native knowledge system: notes on your own server, coding agents on your own machines, and MCP access for AI apps.";
---

<BaseLayout title="Storm — Self-hosted knowledge" description={description}>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-brand"><BrandMark size="md" /></div>
        <p class="eyebrow">Self-hosted notes · agents · MCP</p>
        <h1 id="hero-heading" class="display">
          Your knowledge.<br />On your infrastructure.
        </h1>
        <p class="lede">
          Plain Markdown on a server you run, synced to every device and
          offline-ready. Coding agents that start from a note, run on your own
          machines, and write back what they learn.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="/download">Download</a>
          <a class="btn btn-ghost" href="/docs/">Read the docs</a>
          <a class="btn btn-ghost" href="https://github.com/dewanshDT/Storm" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
        <div class="hero-install">
          <CodeBlock code={release.installCommand} label="Linux · macOS" />
          <p class="install-note">
            Windows: <code>{release.windowsInstallCommand}</code> ·
            <a href="/download">All options →</a>
          </p>
        </div>
      </div>
      <figure class="shot hero-shot">
        <img
          src="/screens/note-edited-by-session.webp"
          width="1600"
          height="1000"
          alt="The Storm app on a desktop: a vault's folder tree, a note in Read mode whose version line says it was edited by an agent session, and its properties."
        />
        <figcaption>A note an agent edited, linking back to the session that did it.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="loop" aria-labelledby="loop-h">
    <div class="wrap">
      <p class="section-label">01 · The loop</p>
      <h2 id="loop-h">From a note to an agent, and back.</h2>
      <ol class="loop">
        <li>
          <span class="step mono">1</span>
          <strong>Start from a note</strong>
          <p>Press Start session on a plan, a bug, a spec. The note is the agent’s context.</p>
        </li>
        <li>
          <span class="step mono">2</span>
          <strong>It works on your machine</strong>
          <p>Claude Code, OpenCode or a shell, in a workspace on a host you own. Drive it from any device.</p>
        </li>
        <li>
          <span class="step mono">3</span>
          <strong>It writes back</strong>
          <p>What it learns lands in the one vault you let it write to, linked to the session.</p>
        </li>
      </ol>
      <figure class="shot shot--wide">
        <img
          src="/screens/session-running.webp"
          width="1600"
          height="1000"
          loading="lazy"
          alt="The Agents view: running and ended sessions in a list, one session's terminal open, and its Context, Wrote and About panel."
        />
      </figure>
    </div>
  </section>

  <section class="section" id="notes" aria-labelledby="notes-h">
    <div class="wrap two-col">
      <div>
        <p class="section-label">02 · Notes</p>
        <h2 id="notes-h">Your notes are just Markdown files.</h2>
        <p class="support">
          Folders of <code>.md</code> files under a storage root you choose —
          greppable, backupable, readable by any other tool. Storm’s own records
          live beside them, never inside.
        </p>
        <ul class="points">
          <li><strong>Offline is normal.</strong> Edits queue on the device and send when the server is back.</li>
          <li><strong>Edits merge.</strong> Two devices, one note: merged line by line, and a real conflict stays visible in the note itself.</li>
          <li><strong>Your YAML stays yours.</strong> Typed properties edit single lines; key order and comments survive.</li>
          <li><strong>Live everywhere.</strong> A change on one device — or in any editor on the server — appears on the others.</li>
        </ul>
        <a class="more" href="/docs/notes/writing/">Notes in the docs →</a>
      </div>
      <div class="terminal-panel" aria-label="Storage root example">
        <div class="panel-head">storage root</div>
        <pre><code>vaults/
├── personal/
│   ├── daily/
│   └── projects/
│       └── storm.md
└── work/
state/   ← indexes · account · agents (never inside vaults)</code></pre>
      </div>
    </div>
  </section>

  <section class="section" id="agents" aria-labelledby="agents-h">
    <div class="wrap two-col two-col--shot">
      <div>
        <p class="section-label">03 · Agents</p>
        <h2 id="agents-h">Run coding agents on your own machines.</h2>
        <p class="support">
          A Runtime Host runs on Linux, macOS or Windows — the server’s own box
          or another — and connects out to your server, so it needs no open
          port. It holds no notes: an agent reads and writes through Storm,
          and only where you allowed it.
        </p>
        <ul class="points">
          <li><strong>One terminal, every device.</strong> Start on the laptop, check in from the phone.</li>
          <li><strong>Paste images</strong> into a session, on desktop, the web and Android.</li>
          <li><strong>Resume</strong> an ended Claude Code or OpenCode session’s own conversation.</li>
        </ul>
        <div class="chips">
          <div class="kv-chip"><span class="k">Agents</span><span class="v">Claude Code · OpenCode · shell</span></div>
          <div class="kv-chip"><span class="k">Hosts</span><span class="v">Linux · macOS · Windows</span></div>
        </div>
        <a class="more" href="/docs/agents/sessions/">Agents in the docs →</a>
      </div>
      <figure class="shot shot--phone">
        <img
          src="/screens/phone-agents.webp"
          width="520"
          height="1125"
          loading="lazy"
          alt="The Agents list on an Android phone: running and ended sessions with the hosts they run on, and a New session button."
        />
      </figure>
    </div>
  </section>

  <section class="section" id="mcp" aria-labelledby="mcp-h">
    <div class="wrap">
      <p class="section-label">04 · Integrations &amp; MCP</p>
      <h2 id="mcp-h">Your agents reach your tools. Your AI apps reach your notes.</h2>
      <div class="two-col">
        <div>
          <h3>Integrations</h3>
          <p class="support">
            Connect Notion, Linear, GitHub or any MCP server once, in the app,
            and choose which hosts may use it. Storm keeps the credential on
            your server, encrypted; agents call through Storm and never see it,
            and get only the tools you allow.
          </p>
        </div>
        <div>
          <h3>MCP</h3>
          <p class="support">
            Claude Code, Claude Desktop, Cursor and other AI apps read your
            notes — and, if you allow it, write them — through Storm’s MCP
            endpoint, each with its own revocable key. The app hands you the
            config, including <code>storm-runtime mcp-connect</code>, which checks
            it reached your server before it sends the key.
          </p>
        </div>
      </div>
      <div class="chips">
        <div class="kv-chip"><span class="k">Tools</span><span class="v">{mcpReadTools.length} read · {mcpWriteTools.length} write</span></div>
        <div class="kv-chip"><span class="k">Endpoint</span><span class="v">/mcp · off by default</span></div>
      </div>
      <ul class="tool-list" aria-label="MCP tools">
        {mcpTools.map((name) => <li><code>{name}</code></li>)}
      </ul>
      <p class="support small">
        Agents in a Storm session also get <code>{mcpAgentTools[0]}</code>,
        which reads the note the session started from. They never get
        {neverForAgents.map((n, i) => <>{i > 0 && ", "}<code>{n}</code></>)}.
        <a href="/docs/reference/mcp-tools/">Every tool →</a>
      </p>
    </div>
  </section>

  <section class="section" id="platforms" aria-labelledby="platforms-h">
    <div class="wrap">
      <p class="section-label">05 · Platforms</p>
      <h2 id="platforms-h">Runs where you do.</h2>
      <div class="table-wrap">
        <table class="matrix">
          <thead>
            <tr><th></th><th>Linux</th><th>macOS</th><th>Windows</th><th>Android</th><th>Web</th></tr>
          </thead>
          <tbody>
            {platforms.map((p) => (
              <tr>
                <th scope="row">{p.what}</th>
                {[p.linux, p.macos, p.windows, p.android, p.web].map((v) => (
                  <td class:list={[v === "yes" && "yes", v === "—" && "no"]}>{v === "yes" ? "●" : v}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="support small">“web” means the web app, served by your own server.</p>
    </div>
  </section>

  <section class="section" id="yours" aria-labelledby="yours-h">
    <div class="wrap">
      <p class="section-label">06 · Yours</p>
      <h2 id="yours-h">Yours by construction.</h2>
      <ul class="grid-points">
        <li><strong>One account, yours.</strong> A password on your server. No cloud account, no identity provider.</li>
        <li><strong>Every device pairs.</strong> Each gets its own credential, and checks your server’s identity before sending it.</li>
        <li><strong>Files on disk.</strong> Leave whenever you like: your notes were Markdown all along.</li>
        <li><strong>Nothing opened silently.</strong> The installer asks before allowing Storm on your local network — and only there.</li>
      </ul>
    </div>
  </section>

  <section class="section" id="docs" aria-labelledby="docs-h">
    <div class="wrap">
      <p class="section-label">07 · Start</p>
      <h2 id="docs-h">Run it on your own machine.</h2>
      <p class="support">
        One command installs the server and pairs your phone. The docs cover
        the rest.
      </p>
      <p class="cta"><a class="btn btn-primary" href="/download">Download Storm</a></p>
      <ul class="doc-grid">
        {docs.map((d) => (
          <li>
            <a href={d.href}>
              <strong>{d.title}</strong>
              <span>{d.body}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: calc(var(--sp) * 8) 0 calc(var(--sp) * 7);
    border-bottom: var(--bw) solid var(--border);
  }
  .hero-grid {
    display: grid;
    gap: calc(var(--sp) * 5);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
  .hero-brand {
    margin-bottom: calc(var(--sp) * 3);
  }
  .hero .eyebrow {
    margin: 0 0 calc(var(--sp) * 2);
  }
  .display {
    margin: 0 0 calc(var(--sp) * 3);
    font-family: var(--font-body);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .lede {
    margin: 0 0 calc(var(--sp) * 4);
    font-family: var(--font-body);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text2);
    max-width: 36rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--sp) * 1.5);
    margin: 0 0 calc(var(--sp) * 4);
  }
  .hero-install {
    max-width: 36rem;
  }
  /* The install line is the call to action: wrap it rather than scroll it,
     so the end of the command (`| sh`) is never hidden. Copy is unaffected. */
  .hero-install :global(pre) {
    white-space: pre-wrap;
    word-break: break-all;
  }
  .install-note {
    margin: calc(var(--sp) * 1.5) 0 0;
    font-size: var(--fs-sm);
    color: var(--text3);
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text);
  }
  .shot {
    margin: 0;
  }
  .shot img {
    width: 100%;
    border: var(--bw) solid var(--border);
    border-radius: calc(var(--r-control) * 0.8);
    box-shadow: var(--shadow);
    background: var(--surface);
  }
  .shot figcaption {
    margin-top: calc(var(--sp) * 1.5);
    font-size: var(--fs-sm);
    color: var(--text3);
  }
  .shot--wide {
    max-width: 920px;
    margin: 0 auto;
  }
  .shot--phone {
    justify-self: center;
    max-width: 260px;
  }
  .shot--phone img {
    border-radius: 22px;
  }
  .loop {
    list-style: none;
    padding: 0;
    margin: calc(var(--sp) * 3) 0 calc(var(--sp) * 5);
    display: grid;
    gap: calc(var(--sp) * 3);
  }
  @media (min-width: 760px) {
    .loop {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .loop li {
    border-top: var(--bw) solid var(--border);
    padding-top: calc(var(--sp) * 2);
  }
  .loop strong {
    display: block;
    margin: calc(var(--sp) * 1) 0 calc(var(--sp) * 0.75);
    color: var(--text);
  }
  .loop p {
    margin: 0;
    color: var(--text2);
    line-height: 1.55;
  }
  .step {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--accent);
  }
  .two-col {
    display: grid;
    gap: calc(var(--sp) * 4);
    align-items: start;
  }
  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
    .two-col--shot {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
  }
  .section h3 {
    margin: calc(var(--sp) * 2) 0 calc(var(--sp) * 1);
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--text);
  }
  .points,
  .grid-points {
    list-style: none;
    padding: 0;
    margin: calc(var(--sp) * 2) 0;
    display: grid;
    gap: calc(var(--sp) * 1.5);
  }
  .points li,
  .grid-points li {
    color: var(--text2);
    line-height: 1.55;
  }
  .points strong,
  .grid-points strong {
    color: var(--text);
  }
  @media (min-width: 760px) {
    .grid-points {
      grid-template-columns: 1fr 1fr;
      gap: calc(var(--sp) * 3);
    }
  }
  .more {
    display: inline-block;
    margin-top: calc(var(--sp) * 1);
    font-size: var(--fs-sm);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--sp) * 1);
    margin: calc(var(--sp) * 2) 0;
  }
  .tool-list {
    list-style: none;
    padding: 0;
    margin: 0 0 calc(var(--sp) * 2);
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--sp) * 0.75);
  }
  .tool-list code {
    display: inline-block;
    padding: 2px 8px;
    font-size: var(--fs-xs);
    border: var(--bw) solid var(--border);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--text2);
  }
  .small {
    font-size: var(--fs-sm);
  }
  .table-wrap {
    overflow-x: auto;
  }
  .matrix {
    border-collapse: collapse;
    min-width: 34rem;
    width: 100%;
    font-size: var(--fs-sm);
  }
  .matrix th,
  .matrix td {
    padding: calc(var(--sp) * 1.25) calc(var(--sp) * 1.5);
    border-bottom: var(--bw) solid var(--border);
    text-align: center;
    color: var(--text2);
  }
  .matrix th[scope="row"] {
    text-align: left;
    color: var(--text);
    font-weight: 500;
  }
  .matrix thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text3);
  }
  .matrix .yes {
    color: var(--accent);
  }
  .matrix .no {
    color: var(--text3);
  }
  .doc-grid {
    list-style: none;
    padding: 0;
    margin: calc(var(--sp) * 4) 0 0;
    display: grid;
    gap: calc(var(--sp) * 1.5);
  }
  @media (min-width: 640px) {
    .doc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .doc-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .doc-grid a {
    display: block;
    height: 100%;
    padding: calc(var(--sp) * 2);
    border: var(--bw) solid var(--border);
    border-radius: var(--r-card);
    background: var(--surface);
    text-decoration: none;
  }
  .doc-grid a:hover {
    border-color: var(--accent);
  }
  .doc-grid strong {
    display: block;
    color: var(--text);
  }
  .doc-grid span {
    display: block;
    margin-top: calc(var(--sp) * 0.5);
    font-size: var(--fs-sm);
    color: var(--text2);
  }
</style>
