#!/bin/sh
set -e

# Create the system user and default data directories. First start is owned by
# `storm-server up` — installing the package alone must not bind the port or
# assume a data root.

if ! id storm >/dev/null 2>&1; then
    useradd --system --home /srv/storm --shell /usr/sbin/nologin storm || true
fi

mkdir -p /srv/storm/vaults /srv/storm/state /srv/storm/backups /etc/storm
# Only claim ownership on a *fresh* tree. An upgrade must not yank /srv/storm
# away from the operator `up` chose — NFS vault layouts run the unit as the
# state-dir owner (often a real user), and `chown -R storm:storm` on every
# apt upgrade makes serve fail with Permission denied on vaults.json.
if [ ! -e /srv/storm/state/vaults.json ]; then
    chown -R storm:storm /srv/storm 2>/dev/null || true
fi

if [ -f /etc/storm/storm.env ]; then
    # There is no token to generate any more — authentication is per-device
    # pairing plus sessions. The file still holds paths, and it is still 600
    # because an upgrade from before the cutover leaves a stale STORM_TOKEN
    # line in it that nobody reads.
    chmod 600 /etc/storm/storm.env || true
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true

    # One-time repair, for an upgrade from a version whose prerm ignored $1
    # (every release up to 0.2.8; decision 70). dpkg runs the *old* package's
    # prerm on upgrade, so even the upgrade to this fixed version has just
    # stopped and disabled storm-server and the backup timer. Put back what
    # `storm-server up` set, on boxes `up` configured (it always writes this
    # drop-in). The server is started too, since the old prerm stopped it.
    # Not repeated on later upgrades: the fixed prerm no longer does the damage.
    # An operator who had run `storm-server down` is re-enabled this once, and
    # the postinst message says so.
    if [ "$1" = "configure" ] && [ -n "$2" ] \
        && dpkg --compare-versions "$2" le "0.2.8-1" \
        && [ -f /etc/systemd/system/storm-server.service.d/data-root.conf ]; then
        systemctl enable --now storm-server || true
        systemctl enable --now storm-backup.timer 2>/dev/null || true
        echo "storm-server: re-enabled storm-server and storm-backup.timer, which"
        echo "  upgrades from $2 and earlier disabled. If you had run"
        echo "  \`storm-server down\` on purpose, run it again."
    fi
fi

echo "storm-server installed. Start it with: sudo storm-server up"
echo "  (or: sudo storm-server up --data-root /path/to/data)"

exit 0
