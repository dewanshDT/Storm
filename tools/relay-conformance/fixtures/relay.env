# The timers and limits a relay under test must be started with
# (tools/relay-conformance/README.md, "The fixture contract"). storm-relay reads
# these names from its environment; any other relay maps them onto its own
# configuration. The suite reads this file too, so it knows what to expect.
#
# Every value is shortened or tightened from the production default (in
# brackets) so that the suite never sleeps a real 30 s.

# A CHALLENGE nonce is answerable for this long (§4) [30000].
STORM_RELAY_CHALLENGE_TTL_MS=2000

# A HELLO for a server_id with no live trunk is held this long before
# ERROR{server_unreachable} (§5) [5000].
STORM_RELAY_HELLO_WAIT_MS=1000

# A STREAM_OPEN unacknowledged this long is ERROR{server_timeout} (§5.1) [5000].
STORM_RELAY_STREAM_ACK_TIMEOUT_MS=1000

# A server trunk that sends nothing for this long is dead: trunk_lost to its
# clients, and new HELLOs are not routed to it (§4.2) [45000].
STORM_RELAY_HEARTBEAT_DEADLINE_MS=2000

# A superseded trunk's open streams get this long before
# ERROR{trunk_superseded} (§4.2) [30000].
STORM_RELAY_SUPERSESSION_DRAIN_MS=1500

# HELLOs one source IP may make per window before ERROR{rate_limited} (§6)
# [10 per 60000].
STORM_RELAY_HELLO_RATE_LIMIT=30
STORM_RELAY_HELLO_RATE_WINDOW_MS=1000
# Every check registers its own servers from one address.
STORM_RELAY_REGISTER_RATE_LIMIT=600
STORM_RELAY_REGISTER_RATE_WINDOW_MS=1000

# Unacknowledged STREAM_OPENs one client trunk may hold; the next OPEN_STREAM
# is ERROR{rate_limited, attempt_id} (§5.1) [20].
STORM_RELAY_MAX_IN_FLIGHT_STREAMS=4

# Open streams one server trunk may carry across all its clients; the next
# OPEN_STREAM is ERROR{rate_limited, attempt_id} (§6) [1000].
STORM_RELAY_MAX_TOTAL_STREAMS=8

# Bytes queued toward one client trunk that has stopped reading before the
# stream the next frame was for is ended with ERROR{client_backlogged} (§5.4)
# [33554432].
STORM_RELAY_MAX_CLIENT_BUFFER_BYTES=1048576
