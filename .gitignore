# Rust
/apps/server/target/
/tools/argon2-bench/target/

# Flutter / Dart
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# Storm runtime data — never commit a vault or its index. The vault is the
# user's notes; the index holds full version history.
#
# Anchored with a leading slash on purpose: bare `state/` matches a directory
# of that name at ANY depth, which silently untracked apps/client/lib/state/.
/vault/
/state/
*.db
*.db-shm
*.db-wal

# Local dev scratch: the Makefile's default VAULT/STATE and live-test data.
/.dev/

# Local overrides
.env
*.local

# Git worktrees nested inside the repo (e.g. .claude/worktrees/) — their
# checkouts are full repos and must never be staged from here.
.git/worktrees/
.claude/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Python bytecode from the integration suites. One .pyc was tracked, so every
# `make test-live` left the tree dirty and every `git status` had a line in it
# that meant nothing.
__pycache__/
*.pyc
